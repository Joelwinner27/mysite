---
interface Props {
  kicker: string;
  title: string;
  intro?: string;
}
const { kicker, title, intro } = Astro.props;
---
<header class="mx-auto max-w-6xl px-6 pt-12 pb-6">
  <p data-reveal class="kicker text-press">{kicker}</p>
  <h1 data-reveal class="mt-3 font-masthead text-5xl font-extrabold tracking-tight sm:text-6xl">{title}</h1>
  {intro && <p data-reveal class="mt-4 max-w-[680px] text-xl text-ink-soft italic">{intro}</p>}
</header>
