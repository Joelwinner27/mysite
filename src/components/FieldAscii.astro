---
// Top-down football drive rendered as ASCII cells behind the home intro.
// Same idea as the ASCII-art animations going around on X: draw the scene with plain
// canvas shapes on a tiny offscreen canvas, average each cell's pixels, then paint every
// cell as a colored block plus a monospace glyph picked from its brightness.
---
<canvas id="field-ascii" aria-hidden="true" class="field-ascii pointer-events-none absolute inset-0 h-full w-full"></canvas>

<style>
  .field-ascii {
    mask-image: linear-gradient(to bottom, transparent 0, #000 10%, #000 70%, transparent 100%);
  }
</style>

<script>
  const cv = document.getElementById("field-ascii") as HTMLCanvasElement;
  const ctx = cv.getContext("2d")!;
  const TAU = Math.PI * 2;

  // ---------- helpers ----------
  type V = [number, number];
  type C3 = [number, number, number];
  const hash = (a: number, b: number, c: number) => { const h = Math.sin(a * 127.1 + b * 311.7 + c * 74.7) * 43758.5453; return h - Math.floor(h); };
  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
  const smooth = (a: number, b: number, v: number) => { const k = clamp((v - a) / (b - a)); return k * k * (3 - 2 * k); };
  const lerp = (a: number, b: number, k: number) => a + (b - a) * k;
  const mix = (a: C3, b: C3, k: number): C3 => [lerp(a[0], b[0], k), lerp(a[1], b[1], k), lerp(a[2], b[2], k)];
  const rgb = (c: C3, a = 1) => `rgba(${c[0] | 0},${c[1] | 0},${c[2] | 0},${a})`;
  const lum = (c: C3) => (0.299 * c[0] + 0.587 * c[1] + 0.114 * c[2]) / 255;
  const ell = (g: CanvasRenderingContext2D, x: number, y: number, rx: number, ry: number, fill: string) => { g.beginPath(); g.ellipse(x, y, rx, ry, 0, 0, TAU); g.fillStyle = fill; g.fill(); };

  // Piecewise-linear track through [t, x, y] keys.
  type Key = [number, number, number];
  const track = (keys: Key[], t: number): V => {
    if (t <= keys[0][0]) return [keys[0][1], keys[0][2]];
    for (let i = 1; i < keys.length; i++) if (t <= keys[i][0]) {
      const [t0, x0, y0] = keys[i - 1], [t1, x1, y1] = keys[i], k = (t - t0) / (t1 - t0);
      return [lerp(x0, x1, k), lerp(y0, y1, k)];
    }
    const k = keys[keys.length - 1];
    return [k[1], k[2]];
  };

  // ---------- the teams (yards relative to the line of scrimmage, offense attacks +x) ----------
  const OFF: Record<string, V> = {
    C: [-0.8, 0], LG: [-1, -2.5], RG: [-1, 2.5], LT: [-1.2, -5], RT: [-1.2, 5], TE: [-1.4, 7.6],
    QB: [-5, 0], RB: [-5.4, -2.6], X: [-1, -14], Z: [-1, 14], S: [-1.6, -10.5],
  };
  const DEF: Record<string, V> = {
    DE1: [1.4, -6.2], DT1: [1.4, -2.1], DT2: [1.4, 2.1], DE2: [1.4, 6.2], LB1: [5.5, -6], LB2: [5.5, 0], LB3: [5.5, 6],
    CB1: [6.5, -14], CB2: [6.5, 14], FS: [12, -7], SS: [12, 7],
  };
  const LINE = ["C", "LG", "RG", "LT", "RT"];
  const at = (name: string, t: number, ...rest: [number, number][]): Key[] => [[0, ...OFF[name]], ...rest.map(([x, y], i) => [t * (i + 1) / rest.length, x, y] as Key)];

  type Play = { tracks: Record<string, Key[]>; carrier: string; release: number; catchT: number; tEnd: number };

  // Three plays on a loop: a post, an inside run and an out route. `gain` is where the carrier goes down.
  function makePlay(type: string, gain: number): Play {
    const tr: Record<string, Key[]> = {};
    for (const n of LINE) tr[n] = [[0, ...OFF[n]], [0.8, OFF[n][0] - 1.1, OFF[n][1]]];
    const runTo = (keys: Key[], x: number, y: number, speed: number) => {
      const [t, px, py] = keys[keys.length - 1];
      keys.push([t + Math.hypot(x - px, y - py) / speed, x, y]);
      return keys;
    };
    let p: Play;
    if (type === "run") {
      const f = Math.min(1, gain / 4);
      tr.QB = [[0, -5, 0], [0.5, -5, -0.8], [1.4, -6.5, 1.5]];
      tr.RB = runTo([[0, -5.4, -2.4], [0.5, -4.6, -0.8], [1.0, -1.5, -0.3], [1.4, 1.2 * f, 0.6]], gain, 1.5, 6);
      tr.TE = [[0, ...OFF.TE], [0.6, 0, 5.6]];
      tr.X = [[0, ...OFF.X], [1.6, 3, -13.5]];
      tr.Z = [[0, ...OFF.Z], [1.6, 3, 13.5]];
      tr.S = [[0, ...OFF.S], [1.2, 2.5, -8]];
      p = { tracks: tr, carrier: "RB", release: 0.5, catchT: 0.5, tEnd: tr.RB[tr.RB.length - 1][0] };
    } else if (type === "out") {
      const f = Math.min(1, (gain - 1) / 11);
      tr.QB = [[0, -5, 0], [0.9, -7.5, 0], [3, -7.5, 0.6]];
      tr.RB = [[0, ...OFF.RB], [0.6, -4.5, -3.2]];
      tr.Z = runTo([[0, ...OFF.Z], [1.1, 9 * f, 14.5], [1.6, 10.5 * f, 17], [2.3, 11 * f, 18.5]], gain, 19.5, 7);
      tr.X = at("X", 4, [22, -14.5], [27, -12]);
      tr.S = [[0, ...OFF.S], [0.8, 4, -9.5], [2, 7, -3], [4, 9, 0]];
      tr.TE = [[0, ...OFF.TE], [1, 2, 10], [3, 4, 12]];
      p = { tracks: tr, carrier: "Z", release: 1.6, catchT: 2.3, tEnd: tr.Z[tr.Z.length - 1][0] };
    } else {
      const f = Math.min(1, (gain - 1) / 17.5);
      tr.QB = [[0, -5, 0], [0.9, -7.5, 0], [3, -7.5, 0.5]];
      tr.RB = [[0, ...OFF.RB], [0.6, -4.5, -3.2]];
      tr.X = runTo([[0, ...OFF.X], [1.1, 8 * f, -14.5], [2.0, 14 * f, -8.5], [2.9, 17.5 * f, -5]], gain, -2, 7.5);
      tr.Z = at("Z", 5, [20, 14.5], [26, 13]);
      tr.S = [[0, ...OFF.S], [0.8, 4, -9.5], [2, 7, -3], [4, 9, 0]];
      tr.TE = [[0, ...OFF.TE], [1, 4, 6.5], [3, 10, 8]];
      p = { tracks: tr, carrier: "X", release: 2.0, catchT: 2.9, tEnd: tr.X[tr.X.length - 1][0] };
    }
    return p;
  }

  // ---------- the drive: a fixed script that loops ----------
  const PRE = 1.2, RESET = 2.3, TD_RESET = 3.4;
  type Snap = { t0: number; L: number; toGain: number; gain: number; play: Play; td: boolean; dur: number };
  const script: Snap[] = [];
  {
    const pattern = ["post", "run", "out", "run", "run", "post", "out"];
    const range: Record<string, [number, number]> = { post: [16, 24], run: [3, 8], out: [10, 14] };
    let t = 0, L = 25, toGain = 35, drives = 0;
    for (let i = 0; drives < 2; i++) {
      const type = pattern[i % pattern.length], [a, b] = range[type];
      let gain = Math.round(a + (b - a) * hash(i, 3, 7)), td = false;
      if (L + gain >= 100) { gain = 100 - L + 4; td = true; }
      const play = makePlay(type, gain), dur = PRE + play.tEnd + (td ? TD_RESET : RESET);
      script.push({ t0: t, L, toGain, gain, play, td, dur });
      t += dur;
      if (td) { L = 25; toGain = 35; drives++; } else { L += gain; if (L >= toGain) toGain = L + 10; }
    }
  }
  const TOTAL = script[script.length - 1].t0 + script[script.length - 1].dur;
  const snapAt = (t: number) => { t = ((t % TOTAL) + TOTAL) % TOTAL; let i = 0; while (i < script.length - 1 && script[i + 1].t0 <= t) i++; return { s: script[i], next: script[(i + 1) % script.length], local: t - script[i].t0 - PRE }; };

  // Ball in field yards: x, y and height off the ground.
  function ballIn(s: Snap, local: number): [number, number, number] {
    const p = s.play, L = s.L;
    if (local < 0) return [L, 0, 0];
    const qb = track(p.tracks.QB, local);
    if (local < 0.3) { const k = local / 0.3; return [L + lerp(0, qb[0], k), lerp(0, qb[1], k), 1.2 * Math.sin(Math.PI * k)]; }
    if (local < p.release) return [L + qb[0] + 0.5, qb[1] + 0.4, 0];
    const c = track(p.tracks[p.carrier], local);
    if (local < p.catchT) {
      const q = track(p.tracks.QB, p.release), e = track(p.tracks[p.carrier], p.catchT), k = (local - p.release) / (p.catchT - p.release);
      return [L + lerp(q[0], e[0], k), lerp(q[1], e[1], k), 5 * k * (1 - k) * (p.catchT - p.release)];
    }
    return [L + c[0] + 0.5, c[1] + 0.4, 0];
  }

  // Everyone's spot at time t (absolute field yards).
  type Body = { x: number; y: number; team: 0 | 1; carrier: boolean };
  function playersAt(t: number): { bodies: Body[]; ball: [number, number, number]; s: Snap; local: number; fade: number; td: number } {
    const { s, next, local } = snapAt(t), p = s.play;
    const offAt = (n: string, tt: number): V => { const r = p.tracks[n] ? track(p.tracks[n], Math.max(0, tt)) : OFF[n]; return [s.L + r[0], r[1]]; };
    const ballAtPlay = (tt: number) => ballIn(s, Math.min(tt, p.tEnd));
    const defAt = (n: string, tt: number): V => {
      const base = DEF[n], u = clamp(tt / p.tEnd), b = ballAtPlay(tt - 0.15);
      const back = n.startsWith("CB") || n.endsWith("S") && n.length === 2 ? 2.5 * smooth(0, 0.5, u) : 0;
      const k = (n.startsWith("D") ? 0.85 : 0.9) * smooth(0.06, 1, u);
      const tx = b[0] + (base[0] - 5) * 0.22 * (1 - 0.7 * u), ty = b[1] + base[1] * 0.25 * (1 - 0.7 * u);
      return [lerp(s.L + base[0] + back, tx, k), lerp(base[1], ty, k)];
    };
    const bodies: Body[] = [];
    let ball = ballAtPlay(local), fade = 0, td = 0;
    if (local <= p.tEnd) {
      for (const n in OFF) bodies.push({ x: offAt(n, local)[0], y: offAt(n, local)[1], team: 0, carrier: local > p.catchT && n === p.carrier });
      for (const n in DEF) { const [x, y] = defAt(n, Math.max(0, local)); bodies.push({ x, y, team: 1, carrier: false }); }
    } else {
      // after the whistle: jog back to the next snap (or, after a touchdown, fade to the next drive)
      const R = s.td ? TD_RESET : RESET, u = clamp((local - p.tEnd) / R);
      let k = smooth(0.1, 0.95, u);
      if (s.td) { k = u < 0.5 ? 0 : 1; fade = Math.sin(Math.PI * u) ** 2; td = u < 0.5 ? 1 : 0; }
      for (const n in OFF) { const [x, y] = offAt(n, p.tEnd); bodies.push({ x: lerp(x, next.L + OFF[n][0], k), y: lerp(y, OFF[n][1], k), team: 0, carrier: false }); }
      for (const n in DEF) { const [x, y] = defAt(n, p.tEnd); bodies.push({ x: lerp(x, next.L + DEF[n][0], k), y: lerp(y, DEF[n][1], k), team: 1, carrier: false }); }
      ball = [lerp(ball[0], next.L, k), lerp(ball[1], 0, k), 0];
    }
    return { bodies, ball, s, local, fade, td };
  }

  // ---------- drawing ----------
  const PAPER: C3 = [243, 235, 220], INK: C3 = [35, 28, 20];
  const TURF = ["#7f9a5c", "#88a364"], CHALK = "#f1ead8";
  const TEAMS = [
    { jersey: "#a3322a", helmet: "#7b1f19", stripe: "#f1ead8", pants: "#efe5cf" },
    { jersey: "#22344d", helmet: "#c9a13f", stripe: "#22344d", pants: "#c9a13f" },
  ];

  function player(g: CanvasRenderingContext2D, team: number, t: number, moving: boolean, seed: number) {
    const c = TEAMS[team], st = moving ? Math.sin(t * 15 + seed) : 0;
    ell(g, 0.45 * st, -0.42, 0.42, 0.22, c.pants);
    ell(g, -0.45 * st, 0.42, 0.42, 0.22, c.pants);
    ell(g, -0.35 * st, -0.95, 0.36, 0.2, c.jersey);
    ell(g, 0.35 * st, 0.95, 0.36, 0.2, c.jersey);
    ell(g, 0, 0, 0.62, 0.85, c.jersey);
    ell(g, 0.1, 0, 0.5, 0.48, c.helmet);
    g.fillStyle = c.stripe; g.fillRect(-0.35, -0.09, 0.85, 0.18);
    ell(g, 0.58, 0, 0.1, 0.32, "#e9e2d0");
  }

  let W = 0, H = 0, CW = 8, CH = 11, COLS = 0, ROWS = 0, VIEW_H = 33, ppy = 1;
  const SS = 3;
  const mk = () => { const c = document.createElement("canvas"); return [c, c.getContext("2d", { willReadFrequently: true })!] as const; };
  const [fc, fx] = mk(), [sc, sx] = mk();

  function resize() {
    const r = cv.getBoundingClientRect(), dpr = Math.min(2, window.devicePixelRatio || 1);
    W = r.width; H = r.height;
    const small = W < 640;
    // phones fit the field to the width (the intro is tall there), desktops to the height
    CW = small ? 6 : 8; CH = small ? 9 : 11; ppy = small ? W / 26 : H / 33; VIEW_H = H / ppy;
    COLS = Math.ceil(W / CW); ROWS = Math.ceil(H / CH);
    cv.width = Math.round(W * dpr); cv.height = Math.round(H * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    fc.width = sc.width = COLS * SS; fc.height = sc.height = ROWS * SS;
  }

  const cells = (g: CanvasRenderingContext2D) => {
    const d = g.getImageData(0, 0, COLS * SS, ROWS * SS).data, out = new Float32Array(COLS * ROWS * 4), rw = COLS * SS * 4;
    for (let j = 0; j < ROWS; j++) for (let i = 0; i < COLS; i++) {
      let r = 0, gg = 0, b = 0, a = 0;
      for (let v = 0; v < SS; v++) for (let u = 0, p = (j * SS + v) * rw + i * SS * 4; u < SS; u++, p += 4) { const al = d[p + 3]; r += d[p] * al; gg += d[p + 1] * al; b += d[p + 2] * al; a += al; }
      const o = (j * COLS + i) * 4;
      if (a > 0) { out[o] = r / a; out[o + 1] = gg / a; out[o + 2] = b / a; out[o + 3] = a / (255 * SS * SS); }
    }
    return out;
  };

  const RAMP = "@%#*+=-:.";
  const EDGE = "',.o:;";

  function draw(t: number) {
    const state = playersAt(t), { s, local } = state;
    // the camera trails the ball a little, looking downfield
    let cam = 0;
    for (let k = 0; k < 5; k++) cam += playersAt(t - k * 0.15).ball[0] / 5;
    // on wide screens keep the ball right of the intro text; on phones keep it centered
    const viewW = W / ppy, half = viewW / 2, at = W >= 900 ? 0.6 : 0.45;
    const left = clamp(cam - viewW * at, -12, 112 - viewW), top = -VIEW_H / 2;
    const kx = (SS * ppy) / CW, ky = (SS * ppy) / CH;

    // field layer
    fx.setTransform(1, 0, 0, 1, 0, 0); fx.fillStyle = "#cdbf9f"; fx.fillRect(0, 0, fc.width, fc.height);
    fx.setTransform(kx, 0, 0, ky, -left * kx, -top * ky);
    for (let x = Math.floor(left / 5) * 5; x < left + viewW + 5; x += 5) {
      if (x < -10 || x >= 110) continue;
      fx.fillStyle = x < 0 ? "#2b3c55" : x >= 100 ? "#a3322a" : TURF[(x / 5) & 1];
      fx.fillRect(x, -27, 5, 54);
    }
    fx.fillStyle = CHALK;
    for (let x = Math.ceil(left / 5) * 5; x < left + viewW; x += 5) if (x >= 0 && x <= 100) fx.fillRect(x - 0.18, -27, x % 50 === 0 || x === 0 || x === 100 ? 0.5 : 0.36, 54);
    for (let x = Math.ceil(left); x < left + viewW; x++) if (x > 0 && x < 100 && x % 5) for (const y of [-7, 7, -19.5, 19.5]) fx.fillRect(x - 0.1, y - 0.5, 0.2, 1);
    fx.font = '600 3.6px "Oswald", sans-serif'; fx.textAlign = "center"; fx.textBaseline = "middle";
    for (let x = Math.ceil(left / 10) * 10; x < left + viewW + 10; x += 10) if (x > 0 && x < 100) {
      const n = String(x <= 50 ? x : 100 - x);
      for (const y of [-15, 15]) { fx.fillText(n[0], x - 1.5, y); fx.fillText(n[1], x + 1.5, y); }
    }
    fx.font = '600 7px "Oswald", sans-serif';
    for (const [x, word, rot] of [[-5, "JOEL", Math.PI / 2], [105, "WINNER", -Math.PI / 2]] as const) {
      if (x < left - 10 || x > left + viewW + 10) continue;
      fx.save(); fx.translate(x, 0); fx.rotate(rot); fx.fillStyle = CHALK; fx.fillText(word, 0, 0); fx.restore();
    }
    // line of scrimmage and line to gain, the way TV draws them
    const lines = local <= s.play.tEnd ? 1 : 1 - smooth(0, 0.6, local - s.play.tEnd);
    fx.globalAlpha = 0.85 * lines;
    fx.fillStyle = "#3d6db0"; fx.fillRect(s.L - 0.25, -27, 0.5, 54);
    if (s.toGain < 100) { fx.fillStyle = "#e3b62f"; fx.fillRect(s.toGain - 0.25, -27, 0.5, 54); }
    fx.globalAlpha = 1;
    const field = cells(fx);

    // players and ball layer
    sx.setTransform(1, 0, 0, 1, 0, 0); sx.clearRect(0, 0, sc.width, sc.height);
    sx.setTransform(kx, 0, 0, ky, -left * kx, -top * ky);
    const later = playersAt(t + 0.05).bodies;
    state.bodies.forEach((b, k) => {
      const dx = later[k].x - b.x, dy = later[k].y - b.y, moving = Math.hypot(dx, dy) > 0.05;
      let a = moving ? Math.atan2(dy, dx) : b.team ? Math.PI : 0;
      if (b.team && local > 0 && local <= s.play.tEnd) a = Math.atan2(state.ball[1] - b.y, state.ball[0] - b.x);
      const hop = state.td && b.team === 0 ? Math.abs(Math.sin(t * 8 + k)) * 0.15 : 0;
      sx.save(); sx.translate(b.x, b.y); sx.rotate(a); sx.scale(1.75 + hop, 1.75 + hop); player(sx, b.team, t, moving, k); sx.restore();
    });
    const [bx, by, bh] = state.ball;
    sx.save(); sx.translate(bx, by - bh * 0.6); sx.rotate(t * 2); sx.scale(1 + bh * 0.08, 1 + bh * 0.08);
    ell(sx, 0, 0, 0.75, 0.42, "#7a4a24"); sx.fillStyle = CHALK; sx.fillRect(-0.3, -0.05, 0.6, 0.1); sx.restore();
    if (state.td) {
      sx.setTransform(1, 0, 0, 1, 0, 0);
      const size = Math.min(sc.height * 0.2, (sc.width * (W < 640 ? 0.9 : 0.5)) / 6);
      sx.font = `600 ${size}px "Oswald", sans-serif`; sx.textAlign = "center"; sx.textBaseline = "middle";
      sx.fillStyle = "#e3b62f"; sx.fillText("TOUCHDOWN", sc.width * (W < 640 ? 0.5 : 0.7), sc.height * (W < 640 ? 0.78 : 0.62));
    }
    const sprites = cells(sx);

    // paint the cells
    ctx.clearRect(0, 0, W, H);
    ctx.font = `500 ${Math.round(CH * 0.8)}px "IBM Plex Mono", monospace`; ctx.textAlign = "center"; ctx.textBaseline = "middle";
    const tick = Math.floor(t * 6);
    for (let j = 0; j < ROWS; j++) for (let i = 0; i < COLS; i++) {
      const o = (j * COLS + i) * 4, x = i * CW, y = j * CH, sa = sprites[o + 3];
      let f: C3 = [field[o], field[o + 1], field[o + 2]];
      if (i > 0 && j > 0 && sprites[((j - 1) * COLS + i - 1) * 4 + 3] > 0.3) f = mix(f, [20, 32, 18], 0.3);
      const flick = hash(i, j, tick);
      if (sa > 0.5) {
        const c: C3 = [sprites[o], sprites[o + 1], sprites[o + 2]], l = lum(c);
        ctx.fillStyle = rgb(c); ctx.fillRect(x + 0.5, y + 0.5, CW - 1, CH - 1);
        ctx.fillStyle = rgb(l < 0.45 ? mix(c, [255, 255, 255], 0.55) : mix(c, INK, 0.55));
        ctx.fillText(RAMP[Math.min(RAMP.length - 1, Math.floor(l * 6 + flick * 3))], x + CW / 2, y + CH / 2 + 1);
        continue;
      }
      ctx.fillStyle = rgb(f); ctx.fillRect(x + 0.5, y + 0.5, CW - 1, CH - 1);
      if (sa > 0.12) {
        ctx.fillStyle = rgb([sprites[o], sprites[o + 1], sprites[o + 2]], Math.min(1, sa * 1.8));
        ctx.fillText(EDGE[(flick * EDGE.length) | 0], x + CW / 2, y + CH / 2 + 1);
      } else if (lum(f) > 0.7) {
        ctx.fillStyle = rgb(mix(f, INK, 0.35), 0.7); ctx.fillText(":", x + CW / 2, y + CH / 2 + 1);
      } else if (hash(i, j, 1) > 0.55) {
        ctx.fillStyle = rgb(mix(f, INK, 0.35), 0.35); ctx.fillText(",.'`"[(hash(i, j, 2) * 4) | 0], x + CW / 2, y + CH / 2 + 1);
      }
    }
    if (state.fade > 0) { ctx.fillStyle = rgb(PAPER, state.fade); ctx.fillRect(0, 0, W, H); }
  }

  // ---------- run it ----------
  const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  let visible = true, t0 = performance.now(), last = 0;
  resize();
  new ResizeObserver(() => { resize(); if (still) draw(0.6); }).observe(cv);
  new IntersectionObserver(([e]) => { visible = e.isIntersecting; }).observe(cv);
  if (still) draw(0.6);
  else {
    const loop = (now: number) => {
      if (visible && now - last > 33) { last = now; draw((now - t0) / 1000); }
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);
  }
  document.fonts?.ready.then(() => still && draw(0.6));
</script>
