---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../data/site";

interface Props {
  post: CollectionEntry<"posts">;
}
const { post } = Astro.props;
---
<a href={`/posts/${post.id}/`} class="group block">
  <p class="kicker text-muted">
    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
    {post.data.tags[0] && <span class="text-press"> · {post.data.tags[0]}</span>}
  </p>
  <h3 class="headline mt-2 text-2xl text-ink decoration-press decoration-2 underline-offset-4 group-hover:underline">{post.data.title}</h3>
  <p class="kicker mt-3 text-ink">Read the dispatch →</p>
</a>
