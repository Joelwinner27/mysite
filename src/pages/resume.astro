---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { site } from "../data/site";

// Facts here come from the master profile in the Job Search folder; keep them in sync.
const experience = [
  {
    role: "Financial Analyst, FP&A",
    org: "Total Quality Logistics",
    place: "Cincinnati, OH",
    when: "Aug 2025 – Present",
    bullets: [
      "Own analytics end to end for the international business lines: query certified sources, model and transform the data, build semantic models and Power BI reports, present them and keep them running in production.",
      "Replaced emailed Excel reports and heavy Power Query with a scheduled Python process that loads Microsoft Fabric Lakehouse tables, saving 2+ hours of manual work a week.",
      "Built audit tables in Fabric notebooks with Delta time travel to track how load level financials change through month and quarter close.",
      "Build star schema semantic models with complex DAX, row level security, calculation groups and Direct Lake, tuned with DAX Studio.",
      "Built 10+ Power BI dashboards and maintain about 10 more for finance and sales leaders; maintain and extend a department dashboard viewed by 2,000+ people weekly.",
      "Partner with Data Science on reporting for load pricing models and AI automation projects that informed leadership’s automation decisions.",
    ],
  },
  {
    role: "Undergraduate Teaching Assistant, Computer Science",
    org: "The Ohio State University",
    place: "Columbus, OH",
    when: "Aug 2022 – Aug 2024",
    bullets: ["Graded assignments, answered student questions and held office hours for the intro Java course."],
  },
  {
    role: "Data Analyst Intern",
    org: "American Conservation Coalition",
    place: "",
    when: "Summer internship",
    bullets: ["Built Python web scrapers to automate data pulls from websites."],
  },
];

const skills = [
  ["Languages", "SQL, Python, R, DAX, Java, VBA"],
  ["Data platform", "Microsoft Fabric (Lakehouse, Notebooks, Data Pipelines, Dataflows Gen2), PySpark, Spark SQL"],
  ["BI", "Power BI (star schema modeling, DAX, RLS, Direct Lake), Tableau, Excel"],
  ["Stats and ML", "Clustering, PCA, Naive Bayes, random forest, logistic regression, SARIMA"],
  ["Other", "Git and GitHub, VS Code, REST APIs, GitHub Copilot"],
];

const work = [
  { label: "Pi line board", note: "Live scores and odds board on a Raspberry Pi", href: "/projects/pi-scoreboard/" },
  { label: "MLB park factors", note: "Simulating batted balls across every park", href: "/analysis/mlb_park_factors_analysis/" },
  { label: "March Madness", note: "Clustering champions, testing three models", href: "/analysis/march-madness-analysis/" },
  { label: "Search forecasting", note: "Twenty years of Google Trends, SARIMA", href: "/analysis/projreport/" },
];
---
<Base title="Résumé" description="Joel Winner's résumé: Financial Analyst at Total Quality Logistics building Fabric Lakehouse tables, semantic models and Power BI. B.S. Statistics, Ohio State.">
  <article class="mx-auto max-w-4xl px-6 pt-12">
    <header data-reveal class="flex flex-col gap-6 border-b-2 border-ink pb-6 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="kicker text-press">Résumé</p>
        <h1 class="mt-2 font-masthead text-5xl font-extrabold tracking-tight">Joel Winner</h1>
        <p class="mt-3 max-w-[560px] text-lg text-ink-soft">
          Analyst who builds the data behind the reports: Fabric Lakehouse tables, star schema semantic models and Power BI,
          from SQL query to production.
        </p>
        <p class="kicker mt-3 text-muted">
          Cincinnati, OH · <a href={`mailto:${site.email}`} class="underline underline-offset-4 hover:text-press">{site.email}</a> ·
          <a href={site.links.linkedin} class="underline underline-offset-4 hover:text-press">LinkedIn</a> ·
          <a href={site.links.github} class="underline underline-offset-4 hover:text-press">GitHub</a>
        </p>
      </div>
      <a href={site.resume} class="kicker inline-flex shrink-0 items-center gap-2 self-start bg-ink px-3 py-2 text-paper transition-transform duration-300 ease-base hover:-translate-y-0.5 active:translate-y-px sm:self-auto">
        <Icon name="download-simple" class="size-4" /> Download PDF
      </a>
    </header>

    <section data-reveal class="pt-8">
      <h2 class="kicker text-muted">Experience</h2>
      {
        experience.map((job) => (
          <div class="grid gap-2 border-b border-rule-light py-6 sm:grid-cols-[180px_1fr] sm:gap-6">
            <p class="kicker pt-1 text-muted">{job.when}</p>
            <div>
              <h3 class="headline text-xl">{job.role}</h3>
              <p class="text-ink-soft italic">{job.org}{job.place && `, ${job.place}`}</p>
              <ul class="mt-3 flex list-[square] flex-col gap-2 pl-5 text-ink-soft marker:text-rule">
                {job.bullets.map((b) => <li>{b}</li>)}
              </ul>
            </div>
          </div>
        ))
      }
    </section>

    <section data-reveal class="pt-8">
      <h2 class="kicker text-muted">Education</h2>
      <div class="grid gap-2 border-b border-rule-light py-6 sm:grid-cols-[180px_1fr] sm:gap-6">
        <p class="kicker pt-1 text-muted">May 2025</p>
        <div>
          <h3 class="headline text-xl">B.S. Statistics</h3>
          <p class="text-ink-soft italic">The Ohio State University, Columbus, OH</p>
          <p class="mt-3 text-ink-soft">Coursework: machine learning, relational databases, software development, data analytics, business analytics. Dean’s List.</p>
        </div>
      </div>
    </section>

    <section data-reveal class="pt-8">
      <h2 class="kicker text-muted">Skills</h2>
      <dl class="border-b border-rule-light py-6">
        {
          skills.map(([k, v]) => (
            <div class="grid gap-1 py-2 sm:grid-cols-[180px_1fr] sm:gap-6">
              <dt class="kicker pt-1 text-muted">{k}</dt>
              <dd class="text-ink-soft">{v}</dd>
            </div>
          ))
        }
        <div class="grid gap-1 py-2 sm:grid-cols-[180px_1fr] sm:gap-6">
          <dt class="kicker pt-1 text-muted">Certifications</dt>
          <dd class="text-ink-soft">HackerRank SQL, AWS AI &amp; ML Scholars</dd>
        </div>
      </dl>
    </section>

    <section data-reveal class="pt-8">
      <h2 class="kicker text-muted">Selected work</h2>
      <ul class="grid gap-4 py-6 sm:grid-cols-2">
        {
          work.map((w) => (
            <li>
              <a href={w.href} class="group block border border-ink bg-paper-light p-4 transition-transform duration-300 ease-base hover:-translate-y-0.5">
                <span class="headline text-lg decoration-press decoration-2 underline-offset-4 group-hover:underline">{w.label}</span>
                <span class="mt-1 block text-ink-soft">{w.note}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</Base>
