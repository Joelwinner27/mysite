---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import { formatDate } from "../../data/site";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, sport, summary, tools, date, live } = project.data;
---
<Base title={title} description={summary} image={`/og/projects/${project.id}.png`}>
  <article class="mx-auto max-w-3xl px-6 pt-10">
    <a href="/projects/" class="kicker inline-flex items-center gap-2 text-muted transition-colors duration-300 ease-base hover:text-press">
      <Icon name="arrow-left" class="size-4" /> All projects
    </a>
    <header class="mt-8 border-b border-ink pb-8">
      <p class="kicker flex flex-wrap items-center gap-3 text-press">
        {sport}
        {live && <span class="flex items-center gap-2 text-live"><span class="size-2 rounded-full bg-live" />Live</span>}
      </p>
      <h1 class="mt-4 font-masthead text-4xl leading-tight font-extrabold tracking-tight sm:text-6xl sm:leading-none">{title}</h1>
      <p class="mt-6 text-xl text-ink-soft italic">{summary}</p>
      <p class="kicker mt-6 text-muted">{formatDate(date)}</p>
      <p class="kicker mt-2 text-muted">Built with {tools.join(" · ")}</p>
    </header>
    <div class="prose mt-10">
      <Content />
    </div>
  </article>
</Base>
