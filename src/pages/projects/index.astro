---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import ProjectCard from "../../components/ProjectCard.astro";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Projects" description="Sports analytics, forecasting and data visualization projects by Joel Winner.">
  <PageHeader
    kicker="The archive"
    title="Every project, on the record"
    intro="Models, analyses and dashboards. Each one links to the full write up and code."
  />
  <ol class="mx-auto max-w-6xl border-t-4 border-ink px-6">
    {projects.map((p, i) => <li data-reveal><ProjectCard project={p} number={i + 1} /></li>)}
  </ol>
</Base>
