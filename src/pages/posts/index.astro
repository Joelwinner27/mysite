---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import PostRow from "../../components/PostRow.astro";

const posts = (await getCollection("posts")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Dispatches" description="Short sports analytics posts by Joel Winner: rankings, spreads and charts during the season.">
  <PageHeader kicker="Dispatches" title="Notes from the season" intro="Quick charts and rankings, filed while the games are still being played." />
  <ul class="mx-auto max-w-6xl border-t-4 border-ink px-6">
    {posts.map((p) => <li data-reveal class="border-b border-ink py-8"><PostRow post={p} /></li>)}
  </ul>
</Base>
