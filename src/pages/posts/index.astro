---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import PostRow from "../../components/PostRow.astro";

const posts = (await getCollection("posts")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Blog" description="Short sports analytics posts by Joel Winner: rankings, spreads and charts during the season.">
  <PageHeader eyebrow="Blog" title="Notes from the season" intro="Quick charts and rankings while games are being played." />
  <div data-reveal class="mx-auto max-w-5xl px-6">
    <div class="border-t border-line">
      {posts.map((p) => <PostRow post={p} />)}
    </div>
  </div>
</Base>
