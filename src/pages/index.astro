---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import AnalysisRow from "../components/AnalysisRow.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { byNewest, formatDate, readingTime, site, typeLabel } from "../data/site";

const posts = (await getCollection("analysis")).sort(byNewest);
const [latest, ...recent] = posts;
const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
---
<Base>
  <section class="mx-auto max-w-6xl px-6 pt-16 sm:pt-24">
    <p data-reveal class="kicker text-muted">Cincinnati, Ohio · Ohio State Statistics ’25</p>
    <h1 data-reveal class="mt-4 max-w-[760px] font-masthead text-4xl leading-none font-extrabold tracking-tight sm:text-7xl">
      Analyst by day.<br /> Sports nerd <br class="sm:hidden" />by night.
    </h1>
    <p data-reveal class="mt-6 max-w-[620px] text-xl text-ink-soft">
      I build data models for a living and use the same tools to argue about college football, baseball and March
      Madness. This is where the work behind the posts lives.
    </p>
  </section>

  <section class="mx-auto mt-12 grid max-w-6xl gap-8 px-6 lg:grid-cols-[3fr_2fr]">
    <a data-reveal href={`/analysis/${latest.id}/`} class="group flex flex-col border border-ink bg-paper-light">
      <div class="kicker flex items-center justify-between border-b border-ink px-4 py-2">
        <span class="text-press">Latest · {typeLabel[latest.data.type]} · {latest.data.sport}</span>
        <span class="text-muted">{readingTime(latest.body)}</span>
      </div>
      {
        latest.data.thumbnail && (
          <div class="overflow-hidden border-b border-rule-light p-4">
            <img src={latest.data.thumbnail} alt="" class="newsprint mx-auto max-h-80 w-auto transition-transform duration-700 ease-base group-hover:scale-[1.02]" />
          </div>
        )
      }
      <div class="flex flex-1 flex-col gap-3 p-4">
        <h2 class="font-masthead text-3xl leading-tight font-extrabold decoration-press decoration-2 underline-offset-4 group-hover:underline">{latest.data.title}</h2>
        <p class="text-lg text-ink-soft italic">{latest.data.summary}</p>
        <p class="kicker mt-auto flex items-center justify-between pt-2 text-muted">
          {formatDate(latest.data.date)}
          <span class="inline-flex items-center gap-2 text-ink">Read it <Icon name="arrow-right" class="size-4" /></span>
        </p>
      </div>
    </a>

    <aside data-reveal class="double-rule flex flex-col gap-4 py-4">
      <h2 class="kicker text-muted">Résumé snapshot</h2>
      <dl class="grid grid-cols-[72px_1fr] gap-x-4 gap-y-3">
        <dt class="kicker pt-1 text-muted">2025–</dt>
        <dd><span class="font-semibold text-ink">Financial Analyst, FP&A</span><br /><span class="text-ink-soft">Total Quality Logistics</span></dd>
        <dt class="kicker pt-1 text-muted">2025</dt>
        <dd><span class="font-semibold text-ink">B.S. Statistics</span><br /><span class="text-ink-soft">The Ohio State University</span></dd>
        <dt class="kicker pt-1 text-muted">Builds</dt>
        <dd class="text-ink-soft">Fabric Lakehouse tables, star schema semantic models and Power BI, from SQL query to production.</dd>
        <dt class="kicker pt-1 text-muted">Tools</dt>
        <dd class="text-ink-soft">SQL · Python · R · DAX · Fabric · Power BI</dd>
      </dl>
      <div class="mt-auto flex flex-wrap gap-3 pt-2">
        <a href="/resume/" class="kicker inline-flex items-center gap-2 bg-ink px-3 py-2 text-paper transition-transform duration-300 ease-base hover:-translate-y-0.5 active:translate-y-px">
          Full résumé <Icon name="arrow-right" class="size-4" />
        </a>
        <a href={site.resume} class="kicker inline-flex items-center gap-2 border border-ink px-3 py-2 text-ink transition-colors duration-300 ease-base hover:bg-ink hover:text-paper">
          <Icon name="download-simple" class="size-4" /> PDF
        </a>
      </div>
    </aside>
  </section>

  <section class="mx-auto max-w-6xl px-6 pt-20">
    <div data-reveal class="flex items-end justify-between border-b border-ink pb-2">
      <h2 class="font-masthead text-2xl font-extrabold sm:text-3xl">Recent analysis</h2>
      <a href="/analysis/" class="kicker inline-flex shrink-0 items-center gap-2 text-ink transition-colors duration-300 ease-base hover:text-press">
        All <Icon name="arrow-right" class="size-4" />
      </a>
    </div>
    <div data-reveal>
      {recent.slice(0, 5).map((p) => <AnalysisRow post={p} />)}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pt-20">
    <div data-reveal class="flex items-end justify-between border-b border-ink pb-2">
      <h2 class="font-masthead text-2xl font-extrabold sm:text-3xl">Things I’ve built</h2>
      <a href="/projects/" class="kicker inline-flex shrink-0 items-center gap-2 text-ink transition-colors duration-300 ease-base hover:text-press">
        All projects <Icon name="arrow-right" class="size-4" />
      </a>
    </div>
    <ul class="mt-6 grid gap-6 sm:grid-cols-2">
      {projects.map((p) => <li data-reveal><ProjectCard project={p} /></li>)}
    </ul>
  </section>
</Base>
